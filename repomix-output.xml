<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}7GAMEstore — каталог игр{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #f7f7f7f9;
            color: #2d3747;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        .header-container {
            background: #ffffff;
            border-bottom: 1px solid #e2e7f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            padding: 12px 0 8px 0;
        }

        .brand-logo {
            display: inline-flex;
            align-items: center;
            text-decoration: none;
        }

        .brand-number {
            font-weight: 900;
            font-size: 2.8rem; 
            color: #db0707e1; 
            line-height: 1;
            position: relative;
            z-index: 2;
            text-shadow: 0 4px 8px rgba(255, 71, 77, 0.3);
            transition: transform 0.4s ease, text-shadow 0.4s ease;
            margin-left: 17px; 
        }

        .brand-logo .logo-text {
            max-width: 0;
            opacity: 0;
            overflow: hidden;
            white-space: nowrap;
            font-weight: 700;
            font-size: 1.7rem;
            color: #0d7efd;
            letter-spacing: 0.5px;
            transition: max-width 0.5s ease, opacity 0.4s ease, margin-left 0.4s ease;
        }

        .brand-logo:hover .brand-number {
            transform: scale(1.1) rotate(-3deg);
            text-shadow: 0 6px 14px rgba(255, 71, 87, 0.5);
        }
        .brand-logo:hover .logo-text {
            max-width: 250px;
            opacity: 1;
            margin-left: 10px;
        }

        .cart-box {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 18px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 50px;
            transition: all 0.2s ease;
            color: #475569;
            font-weight: 700;
            text-decoration: none;
        }
        .cart-box:hover {
            background-color: #e0e7ff;
            border-color: #0d6efd;
            color: #0d6efd;
            transform: translateY(-1px);
        }

        .auth-box a {
            text-decoration: none;
            transition: opacity 0.2s;
        }
        .auth-box a:hover {
            opacity: 0.8;
        }

        .bottom-bar {
            border-top: 1px solid #f1f5f9;
            padding-top: 10px;
        }
        .catalog-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background-color: #f8f9fa;
            color: #1a207c;
            font-weight: 700;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.2s, transform 0.2s, color 0.2s;
        }
        .catalog-link:hover {
            background-color: #e9ecef;
            color: #0d6efd;
            transform: scale(1.02);
        }

        @media (max-width: 768px) {
            .top-bar {
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
            }
            .auth-box {
                border-left: none !important;
                border-top: 1px solid #eee;
                padding-left: 0 !important;
                padding-top: 10px;
                margin-top: 5px;
            }
            .brand-number {
                font-size: 2.2rem;
            }
        }
    </style>
</head>
