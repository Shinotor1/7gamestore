<file path="games/views.py">
from django.shortcuts import render, get_object_or_404
from .models import Game, Category

#  Главная страница 
def main_page(request):
    latest_games = Game.objects.order_by('-created_at')[:3]
    return render(request, 'games/main_page.html', {'games': latest_games})

# Страница каталога 
def catalog(request):
    categories = Category.objects.all()
    games = Game.objects.all()
    return render(request, 'games/catalog.html', {'categories': categories, 'games': games})

# Страница категории 
def category_detail(request, category_slug):
    category = get_object_or_404(Category, slug=category_slug)
    games = category.games.all()
    categories = Category.objects.all() # для меню категорий
    return render(request, 'games/catalog.html', {'category': category, 'games': games, 'categories': categories})

# Страница товара 
def game_detail(request, game_slug):
    game = get_object_or_404(Game, slug=game_slug)
    return render(request, 'games/game_detail.html', {'game': game})
