                            <a href="{% url 'users:register' %}" class="btn btn-sm btn-outline-primary px-3">Регистрация</a>
                        {% endif %}
                    </div>
                </div> 
            </div> 

            <div class="bottom-bar mt-2">
                <a href="{% url 'games:catalog' %}" class="catalog-link">
                    <i class="bi bi-grid-3x3-gap-fill text-primary"></i> Каталог игр
                </a>
            </div>

        </div>
    </header>

    <div class="container">
        {% if messages %}
